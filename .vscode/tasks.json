{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build FinBank",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++20",
                "-g",
                "${workspaceFolder}/console/main.cpp",
                "${workspaceFolder}/console/menu.cpp",
                "-o",
                "${workspaceFolder}/FinBank"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}